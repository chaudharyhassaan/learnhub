# Server
PORT=5000
NODE_ENV=development

# Database (replace the placeholders with your own cluster details)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learnhub

# Auth (use a long random string, never commit the real one)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (comma-separated list also works)
CLIENT_URL=http://localhost:5173

# First admin account created by the seed script
SEED_ADMIN_EMAIL=admin@learnhub.test
SEED_ADMIN_PASSWORD=ChangeMe123
